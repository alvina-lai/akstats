# Keep data and scripts byte-for-byte identical on every platform: the app, the README tables,
# and the CI check all compare the bundled CSVs exactly with what the scripts generate.
*.csv  text eol=lf
*.py   text eol=lf
*.R    text eol=lf
*.md   text eol=lf
*.xlsx binary

# The bundled datasets are generated by scripts/: collapse them in diffs and leave them out of language stats.
akstats/PracticeData/*.csv  linguist-generated
akstats/PracticeData/*.xlsx linguist-generated
